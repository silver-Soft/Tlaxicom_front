# ============================================================
# Sitio: https://tlaxicom.com  (dominio canonico: sin www, HTTPS)
# ============================================================
Options -Indexes
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar sin www y https. X-Forwarded-Proto evita bucles si hay proxy/CDN delante.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://tlaxicom.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://tlaxicom.com%{REQUEST_URI} [R=301,L]

  # Rutas de spam indexadas por terceros: 410 Gone (no existen ni deben existir)
  RewriteRule ^(search|category|pcmypage|product|amp|inicio|event|unsubscribe|5xal9[a-z0-9]*)(/|$) - [G,L]
  RewriteRule ^avsoft\.html$ - [G,L]

  # Accesos directos a index.php -> raiz
  RewriteCond %{THE_REQUEST} /index\.php [NC]
  RewriteRule ^index\.php$ / [R=301,L]

  # Sin catch-all: lo que no existe responde 404 real (ErrorDocument)
</IfModule>

# Archivos y carpetas que nunca deben servirse
<FilesMatch "(^\.(ht|git|env|DS_Store)|\.(log|sql|bak|old|orig|swp|zip|tar|gz|7z|rar|ini|sh|md)$|^error_log$|^composer\.(json|lock)$|^package(-lock)?\.json$|^MANIFEST\.sha256$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
